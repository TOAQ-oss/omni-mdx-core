{
  "name": "@toaq-oss/omni-mdx",
  "version": "0.1.21",
  "description": "MDX parser + renderer for Next.js \u2014 Rust core, RSC-compatible",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TOAQ-oss/omni-mdx-core"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "import": "./dist/server.js"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./wasm": {
      "import": "./wasm/mdx_parser.js",
      "require": "./wasm/mdx_parser.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "@toaq-oss/omni-mdx-darwin-arm64": "0.2.7",
    "@toaq-oss/omni-mdx-darwin-x64": "0.2.7",
    "@toaq-oss/omni-mdx-linux-x64-gnu": "0.2.7",
    "@toaq-oss/omni-mdx-win32-x64-msvc": "0.2.7"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@types/katex": "^0.16.0",
    "@types/node": "^25.5.0",
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "katex": "^0.16.0"
  }
}