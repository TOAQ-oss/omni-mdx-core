{
  "name": "@toaq-oss/omni-mdx",
  "version": "0.1.28",
  "description": "MDX parser + renderer for Next.js — Rust core, RSC-compatible",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/TOAQ-oss/omni-mdx-core"
  },
  "bugs": {
    "url": "https://github.com/TOAQ-oss/omni-mdx-core/issues"
  },
  "keywords": [
    "mdx",
    "markdown",
    "nextjs",
    "react-server-components",
    "rust",
    "wasm"
  ],
  "author": "TOAQ-oss <oss@toaq.fr>",
  "contributors": [
    "Côme Bruneteau <dev@toaq.fr>"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "@toaq-oss/omni-mdx-darwin-arm64": "0.2.11",
    "@toaq-oss/omni-mdx-darwin-x64": "0.2.11",
    "@toaq-oss/omni-mdx-linux-x64-gnu": "0.2.11",
    "@toaq-oss/omni-mdx-win32-x64-msvc": "0.2.11"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/katex": "^0.16.0",
    "@types/node": "^25.5.2",
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "katex": "^0.16.0",
    "unified": "^11.0.5"
  }
}
