{
  "name": "@toaq-oss/mdx-engine-core",
  "version": "0.2.0",
  "description": "Native Rust core for @toaq-oss/mdx-engine",
  "license": "MIT",
  "napi": {
    "binaryName": "toaq-parser-core",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --features node --no-js",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "optionalDependencies": {
    "@toaq-oss/mdx-engine-core-darwin-arm64": "0.2.1",
    "@toaq-oss/mdx-engine-core-darwin-x64": "0.2.1",
    "@toaq-oss/mdx-engine-core-linux-x64-gnu": "0.2.1",
    "@toaq-oss/mdx-engine-core-win32-x64-msvc": "0.2.1"
  }
}